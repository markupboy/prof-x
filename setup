#!/usr/bin/env zsh
# prof-x setup — register all skills and rules with Claude Code and Cursor
set -e

# Resolve the physical path (pwd -P). Without it, invoking setup through a symlinked
# path (e.g. ~/Code/prof-x -> ~/.claude/skills/prof-x) leaves zsh's logical pwd
# pointing at the symlink, so SKILLS_DIR is the wrong parent and the Claude Code
# registration below is silently skipped.
PROFX_DIR="$(cd "$(dirname "$0")" && pwd -P)"
SKILLS_DIR="$(dirname "$PROFX_DIR")"
SKILLS_SRC="$PROFX_DIR/skills"
RULES_SRC="$PROFX_DIR/rules"

# Bold/dim only when stdout is a terminal.
if [ -t 1 ]; then
  BOLD=$'\e[1m'; DIM=$'\e[2m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; RED=$'\e[31m'; RESET=$'\e[0m'
else
  BOLD=""; DIM=""; GREEN=""; YELLOW=""; RED=""; RESET=""
fi

# Create or refresh a symlink and echo what happened: new | updated | unchanged | skipped.
# A real file or directory at $target is never touched.
place_link() {
  local src="$1" target="$2"
  if [ -L "$target" ]; then
    if [ "$(readlink "$target")" = "$src" ]; then
      echo "unchanged"
    else
      ln -snf "$src" "$target"
      echo "updated"
    fi
  elif [ -e "$target" ]; then
    echo "skipped"
  else
    ln -snf "$src" "$target"
    echo "new"
  fi
}

# Args: label, dest_dir, kind, then space-separated lists: new, updated, unchanged,
# skipped, pruned.
print_link_summary() {
  local label="$1" dest_dir="$2" kind="$3"
  local new_list="$4" updated_list="$5" unchanged_list="$6" skipped_list="$7" pruned_list="$8"
  local unchanged_count
  unchanged_count=$(print -r -- "$unchanged_list" | wc -w | tr -d ' ')

  echo "${BOLD}$label${RESET} ${DIM}${dest_dir/#$HOME/~}${RESET}"
  [ -n "$new_list" ]     && echo "  ${GREEN}+ new${RESET}        $new_list"
  [ -n "$updated_list" ] && echo "  ${YELLOW}~ relinked${RESET}   $updated_list"
  [ -n "$pruned_list" ]  && echo "  ${YELLOW}- pruned${RESET}     $pruned_list"
  [ -n "$skipped_list" ] && echo "  ${RED}! skipped${RESET}    $skipped_list ${DIM}(real file/dir in the way)${RESET}"
  echo "  ${DIM}= $unchanged_count $kind unchanged${RESET}"
  echo
}

# /pr-review wraps the pr-review-toolkit plugin. Install it if it's missing.
# Non-fatal: a failure here must not abort the skill symlinking above.
install_pr_review_toolkit() {
  local plugin="pr-review-toolkit@claude-plugins-official"

  if ! command -v claude >/dev/null 2>&1; then
    echo "${BOLD}pr-review-toolkit${RESET}\n  ${YELLOW}! skipped${RESET}    'claude' CLI not on PATH."
    echo "    install manually: claude plugin install $plugin"
    return 0
  fi

  if claude plugin list --json 2>/dev/null | grep -q '"id": *"pr-review-toolkit@'; then
    echo "${BOLD}pr-review-toolkit${RESET} ${DIM}plugin${RESET}\n  ${DIM}= already installed${RESET}"
    return 0
  fi

  echo "${BOLD}pr-review-toolkit${RESET} ${DIM}plugin${RESET}\n  installing $plugin…"
  if claude plugin install "$plugin" --scope user >/dev/null 2>&1; then
    echo "  ${GREEN}+ installed${RESET}"
  else
    echo "  ${RED}! install failed${RESET} — install it manually:"
    echo "    claude plugin install $plugin"
    echo "    (if the marketplace is unknown: claude plugin marketplace add anthropics/claude-plugins-public)"
  fi
}

# Symlink every prof-x skill directory into the given skills directory, and
# prune stale symlinks whose source skill no longer exists. Prints a summary
# prefixed with $label. The target directory is created if missing.
link_skills_into() {
  # Don't abort on an unmatched glob (e.g. an empty destination directory).
  setopt local_options null_glob

  local dest_dir="$1"
  local label="$2"

  mkdir -p "$dest_dir"

  local new=() updated=() unchanged=() skipped=()
  local skill_dir skill_name target outcome
  for skill_dir in "$SKILLS_SRC"/*/; do
    if [ -f "$skill_dir/SKILL.md" ]; then
      skill_name="$(basename "$skill_dir")"
      # Skip node_modules
      [ "$skill_name" = "node_modules" ] && continue
      target="$dest_dir/$skill_name"
      outcome="$(place_link "$SKILLS_SRC/$skill_name" "$target")"
      case "$outcome" in
        new) new+=("$skill_name") ;;
        updated) updated+=("$skill_name") ;;
        unchanged) unchanged+=("$skill_name") ;;
        skipped) skipped+=("$skill_name") ;;
      esac
    fi
  done

  # Remove stale symlinks: any symlink in dest_dir that points into this clone
  # (current skills/ layout or a pre-restructure root skill dir) but whose
  # source skill directory no longer exists (e.g. a renamed/removed skill).
  local pruned=()
  local link_dest
  for target in "$dest_dir"/*; do
    [ -L "$target" ] || continue
    link_dest="$(readlink "$target")"
    case "$link_dest" in
      "$SKILLS_SRC"/*|"$PROFX_DIR"/*)
        if [ ! -f "$link_dest/SKILL.md" ]; then
          rm -f "$target"
          pruned+=("$(basename "$target")")
        fi
        ;;
    esac
  done

  print_link_summary "$label" "$dest_dir" "skills" "${new[*]}" "${updated[*]}" "${unchanged[*]}" "${skipped[*]}" "${pruned[*]}"
}

link_rules_into() {
  setopt local_options null_glob

  local dest_dir="$1"
  local extension="$2"
  local label="$3"

  mkdir -p "$dest_dir"

  local new=() updated=() unchanged=() skipped=()
  local rule_file rule_name target outcome
  for rule_file in "$RULES_SRC"/*.md; do
    rule_name="$(basename "$rule_file" .md)"
    target="$dest_dir/$rule_name.$extension"
    outcome="$(place_link "$rule_file" "$target")"
    case "$outcome" in
        new) new+=("$rule_name") ;;
        updated) updated+=("$rule_name") ;;
        unchanged) unchanged+=("$rule_name") ;;
        skipped) skipped+=("$rule_name") ;;
      esac
  done

  local pruned=()
  local link_dest
  for target in "$dest_dir"/*; do
    [ -L "$target" ] || continue
    link_dest="$(readlink "$target")"
    case "$link_dest" in
      "$RULES_SRC"/*)
        if [ ! -f "$link_dest" ]; then
          rm -f "$target"
          pruned+=("$(basename "$target")")
        fi
        ;;
    esac
  done

  print_link_summary "$label" "$dest_dir" "rules" "${new[*]}" "${updated[*]}" "${unchanged[*]}" "${skipped[*]}" "${pruned[*]}"
}

echo "(X) To me, my X-Men! Prof-X ready."

# Register with Claude Code, but only if we're inside a .claude/skills directory.
if [ "$(basename "$SKILLS_DIR")" = "skills" ]; then
  link_skills_into "$SKILLS_DIR" "Claude Code skills"
else
  echo "${BOLD}Claude Code skills${RESET}\n  ${YELLOW}! skipped${RESET}    not inside .claude/skills/\n"
fi
link_rules_into "$HOME/.claude/rules" "md" "Claude Code rules"

# Register with Cursor's global personal skills directory.
link_skills_into "$HOME/.cursor/skills" "Cursor skills"
link_rules_into "$HOME/.cursor/rules" "mdc" "Cursor rules"

install_pr_review_toolkit
